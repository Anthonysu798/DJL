{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["dist", ".next", "node_modules", "bun.lock", "*.tsbuildinfo", "drizzle"],
  "plugins": ["eslint", "oxc", "unicorn", "typescript"],
  "categories": { "correctness": "warn", "suspicious": "warn", "perf": "warn" },
  "rules": { "eslint/no-shadow": "off", "eslint/no-await-in-loop": "off" }
}
