{
    email {$TLS_EMAIL}
}

{$API_HOST} {
    @remote path /relay/* /v1/pairing/code/resolve /v1/trusted/session/resolve /v1/push/session/* /v1/sessions/*/revoke
    handle @remote {
        reverse_proxy {$REMOTE_RELAY_UPSTREAM}
    }
    handle {
        reverse_proxy {$API_UPSTREAM} {
            flush_interval -1
            header_up -Fly-Client-IP
            header_up -CF-Connecting-IP
            header_up X-Forwarded-For {remote_host}
        }
    }
}

{$WEB_HOST} {
    encode zstd gzip
    reverse_proxy {$WEB_UPSTREAM}
}

{$ADMIN_HOST} {
    encode zstd gzip
    reverse_proxy {$ADMIN_UPSTREAM}
}

{$STORAGE_HOST} {
    reverse_proxy {$STORAGE_UPSTREAM}
}
