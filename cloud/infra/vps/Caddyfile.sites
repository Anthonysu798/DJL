# slcor.site user sites. Kept out of the main Caddyfile so a missing origin certificate can
# never stop the API from loading: add these blocks only after the certificate is installed.
# Cloudflare proxies *.slcor.site (its Universal SSL covers the wildcard) and the origin
# presents a Cloudflare Origin CA certificate saved as .secrets/sites-origin/{cert,key}.pem.
*.{$SITES_DOMAIN} {
    tls {$SITES_TLS_DIR}/cert.pem {$SITES_TLS_DIR}/key.pem
    request_body {
        max_size 64KB
    }
    encode zstd gzip
    # The sites service limits visitors by CF-Connecting-IP. Only Cloudflare may set it:
    # drop it from anyone who reaches the origin directly (ranges: cloudflare.com/ips).
    @not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    request_header @not_cloudflare -CF-Connecting-IP
    reverse_proxy {$SITES_UPSTREAM} {
        header_up -Fly-Client-IP
        header_up X-Forwarded-For {remote_host}
    }
}

{$SITES_DOMAIN} {
    tls {$SITES_TLS_DIR}/cert.pem {$SITES_TLS_DIR}/key.pem
    redir https://slcor.com 301
}
