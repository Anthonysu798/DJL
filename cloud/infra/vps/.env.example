# Generate private credentials with ./djl.sh init. Never commit .env.
COMPOSE_PROJECT_NAME=djl-cloud
DJL_ENV=staging
DJL_VERSION=dev
DJL_MOCK_EXTERNALS=false
API_HOST=api-staging.slcor.com
WEB_HOST=staging.slcor.com
ADMIN_HOST=admin-staging.slcor.com
STORAGE_HOST=files-staging.slcor.com
TLS_EMAIL=
COOKIE_DOMAIN=.slcor.com
PASSKEY_RP_ID=slcor.com
# Loopback ports for an existing host reverse proxy. Only the proxy is public.
API_BIND=127.0.0.1:8787
WEB_BIND=127.0.0.1:3002
ADMIN_BIND=127.0.0.1:3001
STORAGE_BIND=127.0.0.1:8333
POSTGRES_ADMIN_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_API_PASSWORD=
POSTGRES_WORKER_PASSWORD=
REDIS_PASSWORD=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
BETTER_AUTH_SECRET=
IP_HASH_SALT=
RESEND_API_KEY=
EMAIL_FROM=DJL Cloud <no-reply@slcor.com>
EMAIL_REPLY_TO=support@slcor.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TOPUP_PRICE_ID=
STRIPE_STARTER_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_BUSINESS_ANNUAL_PRICE_ID=
STRIPE_AUTOPILOT_PRICE_ID=
STRIPE_AUTOPILOT_ANNUAL_PRICE_ID=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
PUBLIC_TERMS_URL=
PUBLIC_PRIVACY_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ALLOWED_CLIENT_IDS=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=
APPLE_APP_BUNDLE_ID=app.djl.ios
# Optional capabilities. No Fly, SMS, Exa, or APNs credentials are needed to boot.
SANDBOX_BACKEND=disabled
EXA_API_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=app.djl.ios
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
