# Copy to .env for local development. Never commit real values.
DJL_ENV=local
DATABASE_URL=postgres://djl:djl@localhost:54329/djl
REDIS_URL=redis://localhost:63799
API_PORT=8787
API_PUBLIC_URL=http://localhost:8787
WEB_PUBLIC_URL=http://localhost:3002
BETTER_AUTH_SECRET=local-dev-secret-change-me-32-bytes-min
# Salt for hashed client IPs; required outside local/test and independent of the auth secret.
IP_HASH_SALT=local-ip-hash-salt
# WebAuthn relying party id: slcor.com in staging/production, localhost when unset in local.
PASSKEY_RP_ID=
# Mocked by default in local. Set DJL_MOCK_EXTERNALS=false to use real test-mode services.
DJL_MOCK_EXTERNALS=true
# Commerce uses its own CAD test ledger, never AI credits or the Stripe top-up gateway.
# Test funds require DJL_ENV=local|test as well; staging/production stay disabled.
DJL_COMMERCE_MODE=disabled
DJL_COMMERCE_CHECKOUT_PAUSED=false
DJL_COMMERCE_WITHDRAWALS_PAUSED=false
# Optional local/test supplier payment documents only; no transfers, bank verification or settlement.
DJL_COMMERCE_SUPPLIER_PAYMENT_RECORDS_ENABLED=false
# Database-only admin monitoring; no email/SMS/webhook delivery or financial mutations.
DJL_COMMERCE_ALERTS_ENABLED=false
# Optional commerce email follow-up. Off until explicitly approved; never borrows RESEND_API_KEY.
DJL_COMMERCE_ALERT_EMAIL_ENABLED=false
DJL_COMMERCE_ALERT_EMAIL_TO=
DJL_COMMERCE_ALERT_EMAIL_FROM=
DJL_COMMERCE_ALERT_EMAIL_RESEND_API_KEY=
# Optional isolated Stripe TEST integration. Never use the AI top-up keys here.
# Explicit opt-in makes ONLY this adapter call Stripe TEST even while AI services remain mocked.
DJL_COMMERCE_PAYMENT_PROVIDER=simulation
DJL_COMMERCE_STRIPE_ENABLED=false
DJL_COMMERCE_STRIPE_SECRET_KEY=
DJL_COMMERCE_STRIPE_WEBHOOK_SECRET=
# Real product image lookup stays off until a real evaluation and model prices are approved.
DJL_COMMERCE_IMAGE_ENABLED=false
DJL_COMMERCE_IMAGE_EVALUATION_APPROVED=false
DJL_COMMERCE_IMAGE_PRICING_VERIFIED=false
# Verify expiry for commerce/image-uploads/ staging and ready objects before enabling uploads.
DJL_COMMERCE_IMAGE_STORAGE_LIFECYCLE_VERIFIED=false
DJL_COMMERCE_IMAGE_MODEL=
DJL_COMMERCE_IMAGE_DAILY_BUDGET_USD_CENTS=
# Explicit public HTTPS media origin for publishing external product images and inference.
# Safe /shop/ paths need no media origin to publish; inference needs an explicit HTTPS web base.
# Must not equal API_PUBLIC_URL. Desktop external media also needs the matching commerce STORAGE origin.
DJL_COMMERCE_MEDIA_ORIGIN=
# Optional hosted Canadian address suggestions, separate from payments. Keep off until Google Places
# API (New), spending quotas, and public terms/privacy notices are approved. Secret is server-only.
DJL_COMMERCE_GOOGLE_ADDRESS_ENABLED=false
DJL_COMMERCE_GOOGLE_PLACES_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TOPUP_PRICE_ID=
RESEND_API_KEY=
# SMS is optional. Leave disabled to run without any Twilio credentials.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional sender for ordinary transactional SMS; Verify OTP uses its service.
TWILIO_FROM_NUMBER=
OPENAI_API_KEY=
OPENAI_API_KEY_FALLBACK=
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_FALLBACK=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_FALLBACK=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Extra Google client ids (comma separated, e.g. the iOS client) accepted for ID-token sign-in.
GOOGLE_ALLOWED_CLIENT_IDS=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=
# Bundle id carried by native Sign in with Apple tokens (default app.djl.ios).
APPLE_APP_BUNDLE_ID=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
COOKIE_DOMAIN=
# Local S3-compatible storage. For VPS hosting use infra/vps/.env.example.
STORAGE_S3_ENDPOINT=http://127.0.0.1:8333
STORAGE_S3_PUBLIC_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_BUCKET=djl-local
STORAGE_ACCESS_KEY_ID=djl-local
STORAGE_SECRET_ACCESS_KEY=djl-local-secret
ADMIN_PUBLIC_URL=http://localhost:3001
ADMIN_MFA_REQUIRED=true
# Optional agent tools. Fly credentials are required only with SANDBOX_BACKEND=fly.
SANDBOX_BACKEND=disabled
EXA_API_KEY=
FLY_API_TOKEN_SANDBOX=
FLY_SANDBOX_APP=
FLY_SANDBOX_IMAGE=
FLY_SANDBOX_REGION=iad
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=app.djl.ios
# Public API URL for the web/admin frontends.
NEXT_PUBLIC_API_URL=http://localhost:8787
