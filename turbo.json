{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "ELECTRON_RENDERER_PORT",
    "DJL_HOME",
    "DJL_REMOTE_RELAY_URL",
    "DJL_RELAY",
    "DJL_DESKTOP_WS_URL",
    "DJL_DESKTOP_USER_DATA_DIR",
    "DJL_DESKTOP_DISPLAY_NAME",
    "DJL_BROWSER_USE_PIPE_PATH",
    "DJL_BROWSER_PERF",
    "DJL_PROVIDER_RUNTIME_IDLE_STOP_MS",
    "DJL_GROK_ACP_DEBUG",
    "DJL_WEB_SOURCEMAP",
    "DJL_SERVER_SOURCEMAP",
    "DJL_DESKTOP_SOURCEMAP",
    "DJL_MODE",
    "DJL_PORT",
    "DJL_NO_BROWSER",
    "DJL_AUTH_TOKEN",
    "DJL_LOG_WS_EVENTS",
    "DJL_HOST",
    "DJL_AUTO_BOOTSTRAP_PROJECT_FROM_CWD",
    "DJL_DOCUMENT_RENDERER_BINARY_PATH",
    "DJL_DOCUMENT_RENDERER_VERSION",
    "DJL_DOCUMENT_RENDERER_MANIFEST_URL",
    "DJL_DOCUMENT_RENDERER_MANIFEST_PUBLIC_KEY_PEM",
    "DJL_DOCUMENT_RENDERER_DOWNLOAD_SIZE_BYTES",
    "DATABASE_URL",
    "REDIS_URL",
    "DJL_ENV",
    "NEXT_PUBLIC_API_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "dist-electron/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "outputs": []
    }
  }
}
