{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "djl-stats",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "djl-stats",
      "database_id": "9470b59e-c69e-4f9c-8a84-47b0c6ace02a",
      "migrations_dir": "migrations",
    },
  ],
  // Per-address ceilings for the public ingest routes. The landing site reports every visit and
  // download from its own server address, so it gets a much higher ceiling than a single desktop.
  "ratelimits": [
    {
      "name": "INSTALL_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "LANDING_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 600, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
