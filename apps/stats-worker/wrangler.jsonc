{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "djl-stats",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "djl-stats",
      // Replace with the ID printed by `wrangler d1 create djl-stats` before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
