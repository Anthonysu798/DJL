{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "djl-remote-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "DJLRelaySession",
      },
      {
        "name": "REGISTRY",
        "class_name": "DJLRelayRegistry",
      },
    ],
  },
  "exports": {
    "DJLRelaySession": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "DJLRelayRegistry": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
