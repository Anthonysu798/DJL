# Docker build context for the DJL Cloud images (cloud/apps/*/Dockerfile).
# The context is the repo root because the root bun.lock covers every
# workspace, so Bun needs each workspace manifest to verify the lockfile.
# Everything else in the monorepo stays out of the image.
**
!package.json
!bun.lock
!bunfig.toml
!patches/**
!apps/*/package.json
!packages/*/package.json
!scripts/package.json
# The public API contract the cloud apps import as @synara/contracts/cloud.
!packages/shared/src/**
!packages/contracts/src/**
!packages/contracts/fixtures/cloud/**
!cloud/**
**/node_modules
**/.turbo
**/.next
**/dist
**/.env
**/.env.*
!**/.env.example
cloud/docs
cloud/infra/cloudflare
cloud/infra/vps/.secrets
cloud/infra/vps/backups
cloud/infra/vps/Caddyfile.host

cloud/infra/vps/compose.host.yml
