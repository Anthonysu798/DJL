{
  "name": "@synara/contracts",
  "version": "0.5.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs"
    },
    "./cloud": {
      "types": "./src/cloud.ts",
      "import": "./src/cloud.ts"
    },
    "./locale-values": {
      "types": "./src/localeValues.ts",
      "import": "./src/localeValues.ts"
    }
  },
  "scripts": {
    "dev": "tsdown src/index.ts --format cjs --watch --clean",
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean",
    "prepare": "effect-language-service patch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures:cloud": "bun scripts/write-cloud-fixtures.ts && oxfmt fixtures/cloud"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
